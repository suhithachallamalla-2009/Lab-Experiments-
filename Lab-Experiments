#include <stdio.h>
#include <math.h>

int main()
{
    float a, b, c, s, area;

    printf("Enter three sides of triangle: ");
    scanf("%f %f %f", &a, &b, &c);

    if (a <= 0 || b <= 0 || c <= 0 ||
        a + b <= c || a + c <= b || b + c <= a)
    {
        printf("Invalid triangle\n");
    }
    else
    {
        s = (a + b + c) / 2;
        area = sqrt(s * (s-a) * (s-b) * (s-c));

        printf("Area = %.2f\n", area);
    }

}









